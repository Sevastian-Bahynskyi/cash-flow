{
  "expo": {
    "name": "Cash Flow",
    "slug": "cash-flow",
    "scheme": "cashflow",
    "icon": "./assets/icon.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.seva.cashflow",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cash Flow uses your photos so you can import transactions from screenshots and receipts."
      }
    },
    "android": {
      "package": "com.seva.cashflow"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cash Flow uses your photos so you can import transactions from screenshots and receipts."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
