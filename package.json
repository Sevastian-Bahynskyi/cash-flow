{
  "name": "cash-flow",
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "web:build": "expo export -p web",
    "web:serve": "serve -s dist -l tcp://127.0.0.1:4173",
    "my-cash-flow": "pnpm web:build && pnpm web:serve",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "node ./scripts/lint-changed.cjs",
    "scan:smells": "node ./scripts/scan-smells.cjs",
    "typecheck": "tsc --noEmit",
    "lockfile:check": "pnpm install --frozen-lockfile --ignore-scripts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@shopify/react-native-skia": "^2.6.2",
    "@supabase/supabase-js": "^2.102.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-location": "^55.1.7",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "patch-package": "^8.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "simple-icons": "^16.15.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "xcode": "3.0.1"
  },
  "private": true
}
